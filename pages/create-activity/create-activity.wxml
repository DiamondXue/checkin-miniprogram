<!-- 创建/编辑活动页 -->
<view class="container">

  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text">加载中…</text>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 表单 -->
    <view class="form-card">

      <!-- 活动名称 -->
      <view class="form-item">
        <text class="form-label">活动名称 <text class="required">*</text></text>
        <input class="form-input" placeholder="如：2026 Q2 团建" value="{{name}}" bindinput="onInput" data-field="name" />
      </view>

      <!-- 活动地点 -->
      <view class="form-item">
        <text class="form-label">活动地点 <text class="required">*</text></text>
        <input class="form-input" placeholder="手动输入活动地点" value="{{location}}" bindinput="onInput" data-field="location" />
        <text class="form-hint">活动地点为文字描述，开启下方位置签到后可选择地图坐标</text>
      </view>

      <!-- 位置签到开关 -->
      <view class="form-item">
        <view class="toggle-row">
          <view class="toggle-info">
            <text class="form-label">位置签到</text>
            <text class="form-hint">开启后需选择签到地点，用户须在范围内才能签到</text>
          </view>
          <switch checked="{{enableLocationCheck}}" bindchange="onLocationCheckToggle" color="#4F46E5" />
        </view>
      </view>

      <!-- 签到地点和范围（开启位置签到时显示） -->
      <view class="form-item" wx:if="{{enableLocationCheck}}">
        <text class="form-label">签到地点</text>
        <view class="location-row" wx:if="{{!latitude}}">
          <view class="choose-location-btn" bindtap="chooseLocation">
            <text>📍 点击选择签到地点</text>
          </view>
        </view>
        <view class="location-row" wx:if="{{latitude}}">
          <text class="location-address-text">{{locationAddress}}</text>
          <view class="location-btn" bindtap="clearLocation">
            <text>✕</text>
          </view>
        </view>
      </view>

      <view class="form-item" wx:if="{{enableLocationCheck}}">
        <text class="form-label">签到范围（米）</text>
        <input class="form-input" type="number" placeholder="默认500米" value="{{checkinRadius}}" bindinput="onRadiusInput" />
        <text class="form-hint">设置签到有效范围，用户需在此范围内才能签到</text>
      </view>

      <!-- 活动日期 -->
      <view class="form-item">
        <text class="form-label">活动日期 <text class="required">*</text></text>
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
          <view class="form-picker">
            <text wx:if="{{date}}">{{date}}</text>
            <text wx:else class="picker-placeholder">请选择日期</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <!-- 时间 -->
      <view class="form-item form-row">
        <view class="form-half">
          <text class="form-label">开始时间</text>
          <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
            <view class="form-picker">
              <text>{{startTime}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>
        <view class="form-half">
          <text class="form-label">结束时间</text>
          <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
            <view class="form-picker">
              <text>{{endTime}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>
      </view>

      <!-- 主办方 -->
      <view class="form-item">
        <text class="form-label">主办方 <text class="required">*</text></text>
        <input class="form-input" placeholder="如：行政部、HR" value="{{organizer}}" bindinput="onInput" data-field="organizer" />
      </view>

      <!-- 扫码确认开关 -->
      <view class="form-item">
        <view class="toggle-row">
          <view class="toggle-info">
            <text class="form-label">扫码确认</text>
            <text class="form-hint">开启后用户签到完成可出示身份码，管理员扫码确认领取项目</text>
          </view>
          <switch checked="{{enableScanConfirm}}" bindchange="onScanConfirmToggle" color="#4F46E5" />
        </view>
      </view>

      <!-- 电子签名开关 -->
      <view class="form-item">
        <view class="toggle-row">
          <view class="toggle-info">
            <text class="form-label">电子签名</text>
            <text class="form-hint">开启后用户签到时需手写签名确认</text>
          </view>
          <switch checked="{{requireSignature}}" bindchange="onSignatureToggle" color="#4F46E5" />
        </view>
      </view>

      <!-- 信息安全模式开关 -->
      <view class="form-item">
        <view class="toggle-row">
          <view class="toggle-info">
            <text class="form-label">信息安全模式</text>
            <text class="form-hint">开启后名单不显示姓名和部门，工号仅显示后6位</text>
          </view>
          <switch checked="{{secureMode}}" bindchange="onSecureModeToggle" color="#4F46E5" />
        </view>
      </view>

      <!-- 投票开关 -->
      <view class="form-item">
        <view class="toggle-row">
          <view class="toggle-info">
            <text class="form-label">活动投票</text>
            <text class="form-hint">开启后已签到的用户可参与投票，管理员手动开始/结束投票</text>
          </view>
          <switch checked="{{enableVote}}" bindchange="onVoteToggle" color="#4F46E5" />
        </view>
      </view>

      <!-- 投票配置（开启投票时显示） -->
      <block wx:if="{{enableVote}}">
        <view class="form-item">
          <text class="form-label">投票标题 <text class="required">*</text></text>
          <input class="form-input" placeholder="如：今晚聚餐选哪里" value="{{voteTitle}}" bindinput="onInput" data-field="voteTitle" />
        </view>

        <view class="form-item">
          <text class="form-label">投票类型</text>
          <view class="vote-type-tabs">
            <view class="vote-type-tab {{voteType === 'single' ? 'active' : ''}}" bindtap="onVoteTypeChange" data-type="single">单选</view>
            <view class="vote-type-tab {{voteType === 'multi' ? 'active' : ''}}" bindtap="onVoteTypeChange" data-type="multi">多选</view>
          </view>
        </view>

        <view class="form-item">
          <text class="form-label">投票选项 <text class="required">*</text></text>
          <text class="form-hint" style="margin-bottom: 16rpx;">至少 2 个选项</text>

          <view class="confirm-item-row" wx:for="{{voteOptions}}" wx:key="key">
            <text class="vote-option-index">{{index + 1}}</text>
            <input
              class="form-input confirm-item-input"
              placeholder="如：火锅"
              value="{{item.label}}"
              bindinput="onVoteOptionInput"
              data-index="{{index}}"
            />
            <view class="confirm-item-del" bindtap="removeVoteOption" data-index="{{index}}">✕</view>
          </view>

          <view class="add-confirm-btn" bindtap="addVoteOption">
            <text>+ 添加选项</text>
          </view>
        </view>

        <view class="form-item form-row" wx:if="{{voteType === 'multi'}}">
          <view class="form-half">
            <text class="form-label">最少投票数</text>
            <input class="form-input" type="number" placeholder="1" value="{{voteMinChoices}}" bindinput="onVoteMinInput" />
          </view>
          <view class="form-half">
            <text class="form-label">最多投票数</text>
            <input class="form-input" type="number" placeholder="不超过选项数" value="{{voteMaxChoices}}" bindinput="onVoteMaxInput" />
          </view>
          <text class="form-hint" style="margin-top: 10rpx;">每人需选择的最少和最多选项个数</text>
        </view>
      </block>

      <!-- 确认项目列表（开启扫码确认时显示） -->
      <view class="form-item" wx:if="{{enableScanConfirm}}">
        <text class="form-label">领取确认项目</text>
        <text class="form-hint" style="margin-bottom: 16rpx;">定义管理员可扫码确认的领取项（如茶点、礼品等）</text>

        <view class="confirm-item-row" wx:for="{{confirmItems}}" wx:key="key">
          <input
            class="form-input confirm-item-input"
            placeholder="如：下午茶点"
            value="{{item.label}}"
            bindinput="onConfirmLabelInput"
            data-index="{{index}}"
          />
          <input
            class="form-input confirm-total-input"
            type="number"
            placeholder="数量"
            value="{{item.total || item.total === 0 ? item.total : ''}}"
            bindinput="onConfirmTotalInput"
            data-index="{{index}}"
          />
          <view class="confirm-item-del" bindtap="removeConfirmItem" data-index="{{index}}">✕</view>
        </view>

        <view class="add-confirm-btn" bindtap="addConfirmItem">
          <text>+ 添加项目</text>
        </view>
      </view>

      <!-- 参与者工号 -->
      <view class="form-item">
        <text class="form-label">参与者工号</text>
        <textarea
          class="form-textarea"
          placeholder="输入参与者工号，用逗号或换行分隔&#10;如：43334382, 10000001, 10000002"
          value="{{participantInput}}"
          bindinput="onInput"
          data-field="participantInput"
          auto-height
          maxlength="-1"
        ></textarea>
        <text class="form-hint">创建后可在活动详情页管理签到</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-area">
      <button class="save-btn {{saving ? 'btn-disabled' : ''}}" bindtap="doSave" disabled="{{saving}}">
        <text wx:if="{{!saving}}">{{isEdit ? '保存修改' : '创建活动'}}</text>
        <text wx:if="{{saving}}">{{isEdit ? '保存中…' : '创建中…'}}</text>
      </button>
      <button wx:if="{{isEdit}}" class="delete-btn" bindtap="doDelete">删除活动</button>
    </view>
  </block>

  <view class="bottom-space"></view>
</view>
