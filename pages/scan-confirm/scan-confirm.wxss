.container {
  min-height: 100vh;
  background: #F3F4F6;
  padding: 30rpx;
}

/* 扫码区域 */
.scan-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.scan-icon-wrapper {
  width: 200rpx;
  height: 200rpx;
  border-radius: 100rpx;
  background: #4F46E5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(79, 70, 229, 0.3);
}

.scan-icon {
  font-size: 80rpx;
  color: #fff;
}

.scan-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #111827;
}

.scan-sub {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-top: 10rpx;
}

/* 用户信息卡 */
.user-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: #4F46E5;
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-detail {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #111827;
}

.user-staffid {
  font-size: 26rpx;
  color: #6B7280;
  margin-top: 6rpx;
}

.user-dept {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

/* 签到状态 */
.checkin-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.card-title {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.checkin-status {
  font-size: 30rpx;
  font-weight: 500;
}

.checkin-status.checked {
  color: #059669;
}

.checkin-status.not-checked {
  color: #EF4444;
}

/* 领取确认 */
.confirm-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.confirm-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.confirm-item:last-child {
  border-bottom: none;
}

.confirm-label {
  font-size: 30rpx;
  color: #374151;
  font-weight: 500;
}

.confirm-status {
  font-size: 26rpx;
  color: #059669;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-confirmed {
  color: #059669;
}

.confirm-remaining {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-left: 12rpx;
}

.confirm-btn {
  font-size: 26rpx;
  padding: 8rpx 30rpx;
  border-radius: 30rpx;
  color: #fff;
  border: none;
  line-height: 1.8;
  background: #4F46E5;
}

.confirm-btn::after {
  border: none;
}

.cancel-btn {
  font-size: 22rpx;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
  color: #EF4444;
  border: 1rpx solid #EF4444;
  background: transparent;
  line-height: 1.8;
}

.cancel-btn::after {
  border: none;
}

.confirm-btn-disabled {
  font-size: 26rpx;
  color: #9CA3AF;
  padding: 8rpx 30rpx;
}

/* 操作按钮 */
.action-buttons {
  margin-top: 20rpx;
}

.scan-again-btn {
  background: #4F46E5;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  border: none;
}

.scan-again-btn::after {
  border: none;
}

.loading {
  text-align: center;
  padding-top: 200rpx;
  color: #9CA3AF;
}
