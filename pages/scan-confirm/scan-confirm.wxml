<view class="container">
  <!-- 扫码按钮（未扫描时显示） -->
  <view class="scan-section" wx:if="{{!scanned}}">
    <view class="scan-icon-wrapper" bindtap="doScan">
      <view class="scan-icon">⊞</view>
    </view>
    <view class="scan-text">点击扫码</view>
    <view class="scan-sub">扫描用户出示的签到码</view>
  </view>

  <!-- 扫描结果 -->
  <view class="result-section" wx:if="{{scanned}}">
    <!-- 用户信息卡 -->
    <view class="user-card">
      <view class="user-avatar">{{scannedUser.name ? scannedUser.name[0] : '?'}}</view>
      <view class="user-detail">
        <view class="user-name">{{scannedUser.name}}</view>
        <view class="user-staffid">工号：{{scannedUser.staffId}}</view>
        <view class="user-dept" wx:if="{{scannedUser.dept}}">{{scannedUser.dept}}</view>
      </view>
    </view>

    <!-- 签到状态 -->
    <view class="checkin-card">
      <view class="card-title">签到状态</view>
      <view class="checkin-status {{scannedParticipant.checked ? 'checked' : 'not-checked'}}">
        {{scannedParticipant.checked ? '✓ 已签到 ' + scannedParticipant.checkedAt : '未签到'}}
      </view>
    </view>

    <!-- 领取确认 -->
    <view class="confirm-section" wx:if="{{confirmItems.length > 0}}">
      <view class="card-title">领取确认</view>

      <view class="confirm-item" wx:for="{{confirmItems}}" wx:key="key">
        <view class="confirm-label">
          {{item.label}}
          <text wx:if="{{item.total !== undefined && item.total !== null && remainingCounts[item.key] !== undefined}}" class="confirm-remaining">余{{remainingCounts[item.key]}}/{{item.total}}</text>
          <text wx:elif="{{item.total !== undefined && item.total !== null}}" class="confirm-remaining">共{{item.total}}</text>
        </view>
        <view class="confirm-status" wx:if="{{confirmations[item.key].confirmed}}">
          <text class="status-confirmed">已确认 {{confirmations[item.key].at}}</text>
          <button class="cancel-btn" bindtap="cancelPickup" data-key="{{item.key}}">取消</button>
        </view>
        <button
          class="confirm-btn"
          wx:elif="{{item.total === undefined || item.total === null || remainingCounts[item.key] === undefined || remainingCounts[item.key] > 0}}"
          bindtap="confirmPickup"
          data-key="{{item.key}}"
        >确认领取</button>
        <text wx:else class="confirm-btn-disabled">已领完</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button class="scan-again-btn" bindtap="doScan">继续扫码</button>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">处理中...</view>
</view>
