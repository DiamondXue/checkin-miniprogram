<!-- 登录页 -->
<view class="container">

  <!-- Logo 区域 -->
  <view class="logo-area">
    <view class="logo-icon">🎯</view>
    <text class="app-name">团建签到</text>
    <text class="app-desc">活动现场签到管理工具</text>
  </view>

  <!-- 登录卡片 -->
  <view class="login-card">
    <!-- 登录方式切换 -->
    <view class="mode-tabs">
      <view class="mode-tab {{loginMode === 'ticket' ? 'mode-tab-active' : ''}}" bindtap="switchMode" data-mode="ticket">入场券登录</view>
      <view class="mode-tab {{loginMode === 'staff' ? 'mode-tab-active' : ''}}" bindtap="switchMode" data-mode="staff">员工登录</view>
    </view>

    <text class="card-subtitle" wx:if="{{loginMode === 'staff'}}">请输入您的员工工号</text>
    <text class="card-subtitle" wx:else>请输入入场券号码</text>

    <!-- 员工工号 -->
    <view class="input-wrap {{inputFocus ? 'input-focus' : ''}} {{inputError ? 'input-error' : ''}}" wx:if="{{loginMode === 'staff'}}">
      <text class="input-icon">👤</text>
      <input
        class="staff-input"
        type="number"
        maxlength="8"
        placeholder="请输入 8 位员工工号"
        placeholder-class="input-placeholder"
        value="{{staffId}}"
        bindinput="onStaffInput"
        bindfocus="onFocus"
        bindblur="onBlur"
        adjust-position="{{true}}"
      />
      <text class="input-clear" wx:if="{{staffId}}" bindtap="clearInput">✕</text>
    </view>

    <!-- 入场券 -->
    <view class="input-wrap {{inputFocus ? 'input-focus' : ''}} {{inputError ? 'input-error' : ''}}" wx:else>
      <text class="input-icon">🎟️</text>
      <input
        class="staff-input"
        type="text"
        maxlength="8"
        placeholder="如：A1234567"
        placeholder-class="input-placeholder"
        value="{{ticketNo}}"
        bindinput="onTicketInput"
        bindfocus="onFocus"
        bindblur="onBlur"
        adjust-position="{{true}}"
      />
      <text class="input-clear" wx:if="{{ticketNo}}" bindtap="clearInput">✕</text>
    </view>

    <!-- 错误提示 -->
    <view class="error-tip" wx:if="{{errorMsg}}">
      <text>⚠️ {{errorMsg}}</text>
    </view>

    <!-- 格式提示 -->
    <text class="format-tip" wx:if="{{!errorMsg && loginMode === 'staff'}}">工号为 8 位数字</text>
    <text class="format-tip" wx:if="{{!errorMsg && loginMode === 'ticket'}}">入场券为 1 位大写字母 + 7 位数字</text>

    <!-- 登录按钮 -->
    <button
      class="login-btn {{canLogin ? 'login-btn-active' : 'login-btn-disabled'}}"
      bindtap="doLogin"
      disabled="{{!canLogin || loading}}"
    >
      <text wx:if="{{!loading}}">登 录</text>
      <text wx:if="{{loading}}">验证中…</text>
    </button>
  </view>

  <!-- 底部说明 -->
  <text class="footer-tip">首次使用请联系管理员录入工号 / 发放入场券</text>

</view>
