<view class="container">
  <!-- 顶部活动信息 -->
  <view class="activity-card" wx:if="{{activity}}">
    <view class="activity-name">{{activity.name}}</view>
    <view class="activity-meta">
      <text>{{activity.date}} {{activity.startTime}} - {{activity.endTime}}</text>
    </view>
    <view class="checkin-status checked" wx:if="{{myChecked}}">
      ✓ 已签到 {{myCheckedAt}}
    </view>
  </view>

  <!-- QR 码展示区域 -->
  <view class="qrcode-section" wx:if="{{myChecked}}">
    <view class="qrcode-label">向管理员出示此码</view>
    <view class="qrcode-wrapper">
      <!-- 新版 type="2d" canvas：真机上更稳定，导出图片前也会直接显示绘制内容 -->
      <canvas
        id="qrcode-canvas"
        type="2d"
        class="qrcode-canvas"
        style="{{qrcodeImagePath ? 'position:absolute;left:-9999px;visibility:hidden;' : ''}}"
      ></canvas>
      <!-- 导出成功后显示图片，便于保存和分享 -->
      <image
        wx:if="{{qrcodeImagePath}}"
        src="{{qrcodeImagePath}}"
        class="qrcode-image"
        mode="aspectFit"
      ></image>
      <!-- 生成中遮罩：canvas 绘制过程中覆盖，导出成功后同步隐藏 -->
      <view wx:if="{{!qrcodeImagePath}}" class="qrcode-loading">
        生成中...
      </view>
    </view>
    <view class="user-info">
      <text class="user-name">{{userInfo.name}}</text>
      <text class="user-staffid">{{userInfo.staffId}}</text>
    </view>

    <!-- 我的领取情况 -->
    <view class="my-pickup-section">
      <view class="my-pickup-title">我的领取情况</view>
      <block wx:if="{{myConfirmList.length > 0}}">
        <view
          wx:for="{{myConfirmList}}"
          wx:key="key"
          class="my-pickup-item {{item.confirmed ? 'confirmed' : 'unconfirmed'}}"
        >
          <view class="my-pickup-label">{{item.label}}</view>
          <view class="my-pickup-status">
            <text wx:if="{{item.confirmed}}" class="status-ok">✓ 已领取</text>
            <text wx:else class="status-wait">未领取</text>
            <view wx:if="{{item.confirmed}}" class="status-detail">
              {{item.at}}{{item.by ? ' · ' + item.by : ''}}
            </view>
          </view>
        </view>
      </block>
      <view wx:else class="my-pickup-empty">暂无领取项目</view>
    </view>

    <view class="qrcode-tip">管理员扫码后可确认茶点/礼品领取</view>
  </view>

  <!-- 未签到提示 -->
  <view class="not-checked" wx:if="{{!myChecked && !loading}}">
    <view class="not-checked-icon">!</view>
    <view class="not-checked-text">请先完成签到</view>
    <view class="not-checked-sub">签到成功后会显示身份二维码</view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
