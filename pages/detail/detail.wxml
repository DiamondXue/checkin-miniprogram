<!-- 管理员/创建人活动详情 & 签到页 -->
<view class="container">

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text">加载中…</text>
  </view>

  <block wx:if="{{!loading && activity}}">
    <!-- 活动信息卡片 -->
    <view class="info-card">
      <view class="activity-title-row">
        <text class="activity-title">{{activity.name}}</text>
        <view class="tag {{statusTagClass}}">{{statusText}}</view>
      </view>
      <view class="info-list">
        <view class="info-row">
          <text class="info-icon">📍</text>
          <text class="info-value">{{activity.location}}</text>
        </view>
        <view class="info-row">
          <text class="info-icon">📅</text>
          <text class="info-value">{{activity.date}}</text>
        </view>
        <view class="info-row">
          <text class="info-icon">🕐</text>
          <text class="info-value">{{activity.startTime}} – {{activity.endTime}}</text>
        </view>
        <view class="info-row">
          <text class="info-icon">👤</text>
          <text class="info-value">主办：{{activity.organizer}}</text>
        </view>
        <view wx:if="{{activity.creatorName}}" class="info-row">
          <text class="info-icon">✏️</text>
          <text class="info-value">创建人：{{activity.creatorName}}</text>
        </view>
      </view>

      <!-- 位置状态栏 -->
      <view class="location-bar" wx:if="{{activity.latitude && activity.status !== 'ended'}}">
        <view class="location-bar-inner {{locationValid === false ? 'location-invalid' : locationValid === true ? 'location-valid' : ''}}">
          <text class="location-text">{{checkingLocation ? '📍 定位中…' : locationInfo}}</text>
          <view class="location-refresh" bindtap="refreshLocation">
            <text>刷新</text>
          </view>
        </view>
      </view>

      <!-- 签到统计 -->
      <view class="checkin-stats">
        <view class="stat-circle">
          <text class="stat-big">{{checkedCount}}</text>
          <text class="stat-small">已签到</text>
        </view>
        <view class="stat-middle">
          <view class="progress-bar-bg">
            <view class="progress-bar-fill" style="width: {{progressPct}}%"></view>
          </view>
          <text class="progress-text">{{progressPct}}% 签到率</text>
        </view>
        <view class="stat-circle">
          <text class="stat-big">{{totalCount}}</text>
          <text class="stat-small">应到人数</text>
        </view>
      </view>

      <!-- 确认领取统计卡片 -->
      <view class="confirm-stats" wx:if="{{activity.enableScanConfirm !== false && confirmStats.length > 0}}">
        <view class="cs-card {{item.unlimited ? (item.confirmed > 0 ? 'cs-partial' : 'cs-none') : (item.remaining !== null && item.remaining <= 0 ? 'cs-all-done' : item.confirmed > 0 ? 'cs-partial' : 'cs-none')}}"
              wx:for="{{confirmStats}}" wx:key="key">
          <text class="cs-label">{{item.label}}</text>
          <view class="cs-progress-wrap" wx:if="{{!item.unlimited}}">
            <view class="cs-progress-bg">
              <view class="cs-progress-fill" style="width: {{item.total > 0 ? item.confirmed / item.total * 100 : 0}}%"></view>
            </view>
          </view>
          <view class="cs-nums">
            <text wx:if="{{!item.unlimited && item.total !== null}}">余量 {{item.remaining}} / {{item.total}}</text>
            <text wx:elif="{{!item.unlimited}}">已领 {{item.confirmed}}</text>
            <text wx:else>已领 {{item.confirmed}} 人</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 管理操作按钮 -->
    <view class="manage-bar" wx:if="{{canEdit}}">
      <view class="manage-btn edit-btn" wx:if="{{canDelete}}" bindtap="goToEdit">
        <text>✏️ 编辑活动</text>
      </view>
      <view class="manage-btn staff-btn" bindtap="toggleStaffPanel">
        <text>👥 管理参与人</text>
      </view>
      <view class="manage-btn scan-btn" wx:if="{{activity.enableScanConfirm !== false}}" bindtap="goToScanConfirm">
        <text>📷 扫码确认</text>
      </view>
      <view class="manage-btn export-btn" wx:if="{{canDelete}}" bindtap="exportCheckinData">
        <text>{{exportLoading ? '导出中…' : '📊 导出签到表'}}</text>
      </view>
      <view class="manage-btn delete-btn" wx:if="{{canDelete}}" bindtap="doDelete">
        <text>🗑️ 删除活动</text>
      </view>
    </view>

    <!-- 管理参与人面板 -->
    <view class="staff-panel" wx:if="{{showStaffPanel && canEdit}}">
      <view class="panel-header">
        <text class="panel-title">管理参与人</text>
        <text class="panel-close" bindtap="toggleStaffPanel">✕</text>
      </view>
      <!-- 新增参与人 -->
      <view class="panel-add">
        <textarea
          class="panel-textarea"
          placeholder="输入工号，逗号或换行分隔"
          value="{{newStaffInput}}"
          bindinput="onNewStaffInput"
          auto-height
          maxlength="-1"
        ></textarea>
        <button class="panel-add-btn" bindtap="doAddParticipants" disabled="{{addingStaff}}">
          {{addingStaff ? '添加中…' : '添加'}}
        </button>
      </view>
      <!-- 已添加的人员列表（可删除） -->
      <scroll-view class="panel-list" scroll-y style="max-height: 600rpx;">
        <view wx:if="{{participants.length === 0}}" class="panel-empty">暂无参与人</view>
        <view class="panel-item" wx:for="{{participants}}" wx:key="_id">
          <view class="panel-item-info">
            <text class="panel-item-name">{{item.name}}</text>
            <text class="panel-item-dept">{{item.dept}}</text>
            <text class="panel-item-id">{{item.staffId}}</text>
            <text wx:if="{{item.checked}}" class="panel-item-checked">✓已签到</text>
          </view>
          <view class="panel-item-del" bindtap="doRemoveParticipant" data-id="{{item._id}}" data-name="{{item.name}}">
            <text>删除</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 搜索栏 -->
    <view class="search-wrap">
      <view class="search-bar">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          placeholder="搜索姓名、部门或工号"
          value="{{keyword}}"
          bindinput="onSearch"
          confirm-type="search"
        />
        <text class="clear-icon" wx:if="{{keyword}}" bindtap="clearSearch">✕</text>
      </view>
      <view class="filter-tabs">
        <view class="filter-tab {{activeFilter === 'all' ? 'active' : ''}}" bindtap="setFilter" data-filter="all">全部({{totalCount}})</view>
        <view class="filter-tab {{activeFilter === 'unchecked' ? 'active' : ''}}" bindtap="setFilter" data-filter="unchecked">未签到({{uncheckedCount}})</view>
        <view class="filter-tab {{activeFilter === 'checked' ? 'active' : ''}}" bindtap="setFilter" data-filter="checked">已签到({{checkedCount}})</view>
      </view>

      <!-- 确认领取筛选 -->
      <view class="confirm-filter-section" wx:if="{{activity.enableScanConfirm !== false && confirmStats.length > 0}}">
        <text class="cf-section-label">确认筛选</text>
        <view class="cf-item-row" wx:for="{{confirmStats}}" wx:key="key">
          <text class="cf-item-label">{{item.label}}{{item.remaining !== null ? ' (余' + item.remaining + ')' : ''}}</text>
          <view class="cf-tab-row">
            <view class="cf-tab {{activeConfirmFilter === 'all' ? 'active' : ''}}" bindtap="setConfirmFilter" data-filter="all">全部</view>
            <view class="cf-tab {{activeConfirmFilter === item.key + '_confirmed' ? 'active' : ''}}" bindtap="setConfirmFilter" data-filter="{{item.key}}_confirmed">已领({{item.confirmed}})</view>
            <view class="cf-tab {{activeConfirmFilter === item.key + '_unconfirmed' ? 'active' : ''}}" bindtap="setConfirmFilter" data-filter="{{item.key}}_unconfirmed">未领({{totalCount - item.confirmed}})</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 人员列表 -->
    <view class="list-wrap">
      <view wx:if="{{filteredList.length === 0}}" class="empty-tip">
        <text>暂无匹配人员</text>
      </view>

      <view
        class="person-item {{item.checked ? 'checked-item' : ''}}"
        wx:for="{{filteredList}}"
        wx:key="_id"
      >
        <view class="person-avatar {{item.checked ? 'avatar-checked' : 'avatar-default'}}">
          <text class="avatar-text">{{item.name[0]}}</text>
        </view>
        <view class="person-info">
          <view class="person-name-row">
            <text class="person-name">{{item.name}}</text>
            <text class="person-dept">{{item.dept}}</text>
          </view>
          <text class="person-phone">工号：{{item.staffId}}</text>
          <text wx:if="{{item.checked}}" class="checked-time">✓ 已签到 {{item.checkedAt}}</text>
          <view wx:if="{{item.checked && item.signatureFileId}}" class="signature-link" bindtap="previewSignature" data-file-id="{{item.signatureFileId}}">
            <text>查看签名</text>
          </view>
          <!-- 确认领取状态 -->
          <view class="confirm-icons" wx:if="{{item._confirmDisplay && item._confirmDisplay.length > 0}}">
            <text wx:for="{{item._confirmDisplay}}" wx:for-item="ci" wx:key="key"
                  class="ci-badge {{ci.confirmed ? 'ci-done' : 'ci-pending'}}">{{ci.label}} {{ci.confirmed ? '✓' : '✗'}}</text>
          </view>
        </view>
        <view class="checkin-btn-wrap">
          <button
            wx:if="{{canDelete && activity.enableScanConfirm !== false && item._confirmDisplay && item._confirmDisplay.length > 0}}"
            class="confirm-direct-btn"
            bindtap="gotoConfirm"
            data-staff-id="{{item.staffId}}"
            data-name="{{item.name}}"
          >核销</button>
          <button
            wx:if="{{canDelete && !item.checked && activity.status !== 'ended'}}"
            class="checkin-btn"
            bindtap="doCheckin"
            data-id="{{item._id}}"
          >签到</button>
          <view wx:if="{{item.checked}}" class="checked-badge">
            <text>✓</text>
          </view>
          <button
            wx:if="{{canDelete && item.checked && activity.status !== 'ended'}}"
            class="undo-btn"
            bindtap="undoCheckin"
            data-id="{{item._id}}"
          >撤销</button>
        </view>
      </view>
    </view>
  </block>

  <view class="bottom-space"></view>
</view>
